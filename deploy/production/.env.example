# Denoise X — production environment template (Sprint 4E, ADR-018/ADR-014).
#
# Runtime configuration (ADR-018): ONE compose stack for every environment —
# only the values below change between local and cloud. Copy to `.env`, run
# `./generate-secrets.sh` to create real credentials, then pick LOCAL or CLOUD
# in the runtime-configuration block below. NO DEFAULT CREDENTIALS ARE SHIPPED
# — a missing or empty variable fails the compose file loudly (ADR-014). Values
# marked `__generate__` are produced by generate-secrets.sh; leave them as-is
# until then (they are valid placeholders, not working credentials).
#
# Compose reads this `.env` for ${VAR} interpolation AND loads it into each app
# service via `env_file`; the compose `environment:` block overrides the
# container-internal wiring (service hostnames). See
# docs/engineering/deployment.md.

# ── Runtime configuration (ADR-013, Sprint 4E) ──────────────────────────────
# One compose stack for every environment; only the values below change.
# Cloud deployment is not a different architecture — it is the same runtime
# with different infrastructure and environment configuration.
#
# LOCAL  (prove the stack on any Docker host — Docker Desktop / Engine):
#   SITE_DOMAIN=localhost
#   CADDYFILE=Caddyfile.local        # Caddy internal CA (self-signed)
#   COMPOSE_PROFILES=frontend        # include the containerized frontend
#   CORS_ORIGINS=["https://localhost"]
#   S3_PUBLIC_ENDPOINT=https://s3.localhost
#   MODEL_WEIGHTS_PATH=../../n2n_unet_best_weights04.keras   # repo root
#
# CLOUD  (go-live on a VM; Let's Encrypt):
#   SITE_DOMAIN=denoise-x.example.com   # api.<SITE_DOMAIN> A record → VM
#   CADDYFILE=Caddyfile                 # default (ACME)
#   COMPOSE_PROFILES=                   # empty → frontend deployed to Vercel
#   CORS_ORIGINS=["https://app.<SITE_DOMAIN>"]
#   S3_PUBLIC_ENDPOINT=https://s3.<SITE_DOMAIN>   # + s3.<domain> A record
#   ACME_EMAIL=ops@example.com
#   MODEL_WEIGHTS_PATH=/opt/denoise/n2n_unet_best_weights04.keras
SITE_DOMAIN=localhost
ACME_EMAIL=
CADDYFILE=Caddyfile.local
COMPOSE_PROFILES=frontend
# NEXT_PUBLIC_API_URL defaults to https://api.<SITE_DOMAIN> (inlined into the
# frontend bundle at build). Override only if the frontend must use a
# different API origin.
# NEXT_PUBLIC_API_URL=https://api.denoise-x.example.com
# Only used when the frontend is containerized and Caddy proxies <SITE_DOMAIN>
# to it (default: frontend:3000 on the compose network).
FRONTEND_UPSTREAM=

# ── Credentials (generate-secrets.sh) ──────────────────────────────────────
POSTGRES_USER=denoise
POSTGRES_PASSWORD=__generate__
POSTGRES_DB=denoise
RABBITMQ_USER=denoise
RABBITMQ_PASS=__generate__
MINIO_ROOT_USER=__generate__
MINIO_ROOT_PASSWORD=__generate__
JWT_SECRET=__generate__
GRAFANA_ADMIN_PASSWORD=__generate__

# ── Object storage (ADR-015) ────────────────────────────────────────────────
# MinIO container (default): S3_ACCESS_KEY/SECRET must equal MINIO_ROOT_USER/
# PASSWORD. Managed S3: STORAGE_PROVIDER=s3, S3_ENDPOINT=https://s3.<region>...
#
# S3_PUBLIC_ENDPOINT is the browser-reachable origin used for presigned
# download URLs (ADR-003): the app talks to S3_ENDPOINT over the compose
# network, but the browser downloads via the Caddy edge, which proxies
# s3.<SITE_DOMAIN> → minio:9000. LOCAL: https://s3.localhost (local_certs).
# CLOUD: https://s3.<SITE_DOMAIN> (needs an `s3.` A record → the VM; Caddy
# issues the Let's Encrypt cert automatically). Empty → presign with
# S3_ENDPOINT (internal/tooling only, not browser-reachable).
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://s3.localhost
S3_ACCESS_KEY=__generate__
S3_SECRET_KEY=__generate__
S3_BUCKET=denoise-xray
S3_REGION=us-east-1
S3_USE_SSL=false
S3_SERVER_SIDE_ENCRYPTION=true
STORAGE_PRESIGN_EXPIRES_SECONDS=900

# ── Images (ADR-016/017) ────────────────────────────────────────────────────
# IMAGE_TAG pins every app service: `latest` for dev; pin a concrete
# <sha>/<semver>/<sprint-tag> for upgrades (ADR-017 compatibility matrix).
# Registry owner MUST be lowercase — Docker image references are lowercase
# only (GHCR normalizes case, so ghcr.io/reckz69 == ghcr.io/Reckz69).
IMAGE_REGISTRY=ghcr.io/reckz69
IMAGE_TAG=latest

# ── Model weights (ADR-011/015) ─────────────────────────────────────────────
# Absolute or compose-file-relative path on the host to the gitignored
# weights; mounted :ro into the worker. Default is the LOCAL layout: weights at
# the repo root, expressed relative to this directory (deploy/production), so a
# clean clone + `gh release download` works unchanged. Cloud VM sets an
# absolute path like /opt/denoise/n2n_unet_best_weights04.keras. Download +
# verify:
#   gh release download weights-v1 --repo Reckz69/medical-xray --pattern 'n2n_unet_best_weights04.keras'
#   bash scripts/verify_weights.sh
MODEL_WEIGHTS_PATH=../../n2n_unet_best_weights04.keras
MODEL_PATH=/weights/n2n_unet_best_weights04.keras
MODEL_NAME=n2n_unet
MODEL_VERSION=v1.0.0
MODEL_TILE=256
NOISE_THRESHOLD=8.0

# ── App runtime ─────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
API_PREFIX=/api/v1
JWT_ALGORITHM=HS256
JWT_ISSUER=denoise-x
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=["https://localhost"]

# Feature flags
ENABLE_SIGNUP=true
ENABLE_DICOM=true
ENABLE_SUPER_RESOLUTION=false
ENABLE_AI_REPORT=false

# Rate limits
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_DAY=3
RATE_LIMIT_UPLOAD_PER_HOUR=20
RATE_LIMIT_DOWNLOAD_PER_HOUR=300

# Upload validation
MAX_UPLOAD_SIZE_MB=50
MIN_IMAGE_DIMENSION=64
MAX_IMAGE_DIMENSION=8192

# Object lifecycle (days) — wired to the object lifecycle rules in Phase 5.
OBJECT_ARCHIVE_DAYS=30
OBJECT_DELETE_DAYS=365

# ── Scheduler knobs (defaults match the gateway/worker) ─────────────────────
SCHEDULER_POLL_INTERVAL_SECONDS=30
SCHEDULER_CLEANUP_INTERVAL_SECONDS=3600
SCHEDULER_CLEANUP_LOCK_TTL_SECONDS=3600
JOB_STALL_TIMEOUT_SECONDS=600
JOB_RETRY_BACKOFF_BASE_SECONDS=30
JOB_RETRY_BACKOFF_MAX_SECONDS=3600
SCAN_PURGE_DAYS=30
CLEANUP_BATCH_SIZE=100

# ── Observability overlay (deploy/production/observability.yml) ─────────────
OTEL_ENABLED=false
OTEL_EXPORTER=otlp-http
OTEL_ENDPOINT=http://otel-collector:4318
METRICS_ENABLED=false
METRICS_PORT=9101
