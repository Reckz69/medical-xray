# Denoise X — environment template.
# Copy to backend/.env and adjust. The gateway reads this from its working
# directory (backend/). Matches deploy/docker-compose.yml defaults.

# ── General ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://denoise:denoise@localhost:5433/denoise

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://denoise:denoise@localhost:5672/

# ── Auth / JWT (override in any non-local environment!) ─────────────────────
JWT_SECRET=change-me-in-prod-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_ISSUER=denoise-x
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Object storage (MinIO) ──────────────────────────────────────────────────
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=denoise-xray
S3_REGION=us-east-1
S3_USE_SSL=false
S3_SERVER_SIDE_ENCRYPTION=false
STORAGE_PRESIGN_EXPIRES_SECONDS=900

# ── Object lifecycle (days) ─────────────────────────────────────────────────
OBJECT_ARCHIVE_DAYS=30
OBJECT_DELETE_DAYS=365

# ── Feature flags ───────────────────────────────────────────────────────────
ENABLE_SIGNUP=true
ENABLE_DICOM=true
ENABLE_SUPER_RESOLUTION=false
ENABLE_AI_REPORT=false

# ── Rate limits ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_DAY=3
RATE_LIMIT_UPLOAD_PER_HOUR=20
RATE_LIMIT_DOWNLOAD_PER_HOUR=300

# ── Upload validation ───────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MIN_IMAGE_DIMENSION=64
MAX_IMAGE_DIMENSION=8192

# ── Model (worker) ──────────────────────────────────────────────────────────
# Path relative to the backend directory; points at the gitignored weights.
MODEL_PATH=../n2n_unet_best_weights04.keras
MODEL_NAME=n2n_unet
MODEL_VERSION=v1.0.0
MODEL_TILE=256
NOISE_THRESHOLD=8.0

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000"]

# ── Observability (Sprint 4B — removable overlay, see deploy/observability.yml)
# Tracing. otlp-http | console. When enabled, app nodes export OTel traces to
# OTEL_ENDPOINT; the overlay points it at the collector container.
OTEL_ENABLED=false
OTEL_EXPORTER=otlp-http
OTEL_ENDPOINT=http://collector:4318
# Metrics. Gateway serves /metrics on the app port; worker/scheduler run a
# Prometheus HTTP server on METRICS_PORT.
METRICS_ENABLED=false
METRICS_PORT=9101
# Grafana (overlay only, host :3001).
GRAFANA_ADMIN_PASSWORD=admin
